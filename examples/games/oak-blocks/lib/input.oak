type Controls:(
    float forward = 0.0
    float strafe = 0.0
    bool jump = false
    bool jump_pressed = false
    bool crouch = false
    bool fly_pressed = false
    bool respawn = false
    bool start = false
    bool pause = false
    bool quit = false
    bool focused = true
    bool break_down = false
    bool place_down = false
    bool break_pressed = false
    bool place_pressed = false
    vec2 look = (0,0)
    int selection = 0
    int scroll = 0
)

def poll(Controls controls):(
    controls.forward = float(int(key_down("W")) - int(key_down("S")))
    controls.strafe = float(int(key_down("D")) - int(key_down("A")))
    controls.jump = key_down("Space")
    controls.jump_pressed = key_pressed("Space")
    controls.crouch = key_down("LShift") or key_down("RShift")
    controls.fly_pressed = key_pressed("F")
    controls.respawn = key_pressed("R")
    controls.start = key_pressed("Enter")
    controls.pause = key_pressed("Escape")
    controls.quit = key_pressed("Q")
    controls.focused = window_focused()
    controls.break_down = mouse_down("Left")
    controls.place_down = mouse_down("Right")
    controls.break_pressed = mouse_pressed("Left")
    controls.place_pressed = mouse_pressed("Right")
    controls.look = mouse_delta()
    controls.selection = 0
    for i in range(1,9):(
        if key_pressed("Number"+string(i)):(controls.selection = i)
    )
    controls.scroll = int(mouse_wheel())
)
