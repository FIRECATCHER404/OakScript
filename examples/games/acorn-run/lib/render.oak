from "game.oak" import Game;TITLE;PLAYING;PAUSED;WON;LOST
from "level.oak" import * as level
from "paint.oak" import * as paint

font face = load_font("../assets/AtkinsonHyperlegible-Regular.ttf")

def tree(float x, float y, float scale, color leaves, color trunk):(
    paint.rect(x-9*scale, y-100*scale, 18*scale, 105*scale, trunk)
    fill_poly([(x,y-40*scale), (x-37*scale,y-77*scale), (x-33*scale,y-83*scale), (x+6*scale,y-47*scale)], trunk)
    paint.oval(x-30*scale, y-108*scale, 42*scale, 44*scale, leaves)
    paint.oval(x+26*scale, y-115*scale, 46*scale, 45*scale, leaves)
    paint.oval(x, y-147*scale, 42*scale, 40*scale, leaves)
)

def backdrop(Game game):(
    clear((190, 216, 203))
    paint.oval(760-game.camera_x*0.025, 154, 62, 62, (238, 233, 194))
    fill_poly([(0,345), (150,246), (345,326), (565,223), (785,293), (960,241), (960,550), (0,550)], (157, 190, 172))
    fill_poly([(0,418), (180,322), (369,392), (602,301), (792,384), (960,320), (960,550), (0,550)], (113, 158, 134))
    for index in range(-1, 9):(
        float x = index * 190.0 - (game.camera_x * 0.18) % 190
        tree(x, 540, 1.1 + (index % 3) * 0.12, (90, 137, 112), (100, 137, 113))
    )
    for index in range(-1, 7):(
        float x = index * 240.0 + 85 - (game.camera_x * 0.40) % 240
        tree(x, 554, 1.55, (61, 111, 87), (68, 107, 86))
    )
    paint.rect(0, 550, 960, 90, (20, 41, 36))
    \# Drifting pollen is decorative, with no random changes to gameplay. #\
    for index in range(12):(
        float x = (index * 113 + game.animation * 13 - game.camera_x * 0.1) % 960
        float y = 235 + sin(game.animation * 0.8 + index) * 24 + (index % 4) * 60
        paint.oval(x, y, 2, 2, (222, 226, 158, 160))
    )
)

def world(Game game):(
    float camera = game.camera_x
    \# The grove exit is drawn behind platforms and the player. #\
    float exit_x = 2625 - camera
    if exit_x > -160 and exit_x < 1120:(
        tree(exit_x, 550, 2.2, (37, 85, 62), (71, 66, 45))
        paint.panel(exit_x-43, 443, 86, 107, 30, (15, 39, 32))
        color glow = (87, 135, 103)
        if game.score == len(level.acorns):(
            glow = (200, 227, 137)
            paint.oval(exit_x, 493, 35, 53, (190, 224, 117, 90))
        )
        paint.panel(exit_x-29, 459, 58, 91, 20, glow)
        paint.centered("THE GROVE", exit_x, 406, 20, paint.cream, face)
    )
    for platform in level.platforms:(
        float x = platform.x - camera
        if x + platform.width >= 0 and x < 960:(
            color soil = (87, 74, 51)
            if not platform.earth:(
                paint.panel(x+4, platform.y+6, platform.width, platform.height+3, 5, (28, 64, 47, 100))
                soil = (114, 86, 53)
            )
            paint.rect(x, platform.y, platform.width, platform.height, soil)
            paint.rect(x, platform.y, platform.width, 7, (128, 181, 111))
            paint.rect(x, platform.y+7, platform.width, 3, (76, 126, 80))
            int stones = int(platform.width / 44)
            for index in range(stones):(
                float sx = x + index * 44 + 14
                if sx > -8 and sx < 960:(paint.rect(sx, platform.y+16+(index%3)*3, 8, 3, (139, 113, 69)))
            )
        )
    )
    for index in range(len(level.checkpoints)):(
        float x = level.checkpoints[index] - camera
        if x > -40 and x < 1000:(
            paint.rect(x, 488, 5, 62, (218, 206, 158))
            color flag = (83, 111, 95)
            if game.checkpoint >= index + 1:(flag = paint.gold)
            fill_poly([(x+5,489), (x+37,493), (x+28,510), (x+5,508)], flag)
        )
    )
    for hazard in level.spikes:(
        float x = hazard.x - camera
        for index in range(int(hazard.y / 16)):(
            float sx = x + index * 16
            if sx > -20 and sx < 960:(
                fill_poly([(sx,550), (sx+8,533), (sx+16,550)], (186, 82, 65))
                fill_poly([(sx+8,533), (sx+9,550), (sx+16,550)], (135, 54, 44))
            )
        )
    )
    for index in range(len(level.acorns)):(
        if not game.collected[index]:(
            vec2 point = level.acorns[index]
            float x = point.x - camera
            if x > -30 and x < 990:(
                float y = point.y + sin(game.animation * 3.0 + index) * 3
                paint.oval(x, y, 19, 22, (255, 224, 130, 38))
                paint.acorn(x, y, 0.9, paint.gold)
            )
        )
    )
    for index in range(len(level.patrols)):(
        float x = level.beetle_x(index, game.elapsed) - camera
        if x > -50 and x < 1000:(
            for foot in range(3):(
                float fx = x+4+foot*10
                paint.rect(fx, 545, 5, 5, paint.ink)
            )
            paint.oval(x+16, 539, 17, 10, (130, 60, 53))
            paint.oval(x+11, 536, 9, 5, (198, 104, 76))
            paint.rect(x+24, 535, 3, 3, paint.cream)
        )
    )
)

def player(Game game):(
    if game.invulnerable > 0 and int(game.animation * 14) % 2 == 0:(return)
    float x = game.player.x - game.camera_x
    float y = game.player.y
    float walk = 0.0
    if game.player.grounded and abs(game.player.vx) > 20:(walk = sin(game.animation * 20) * 2)
    paint.oval(x+14, y+36, 17, 4, (13, 36, 27, 100))
    paint.rect(x+3, y+26, 8, 8+walk, (49, 70, 50))
    paint.rect(x+17, y+26, 8, 8-walk, (49, 70, 50))
    paint.panel(x+2, y+9, 24, 21, 5, (240, 184, 79))
    paint.panel(x+4, y, 20, 18, 5, (246, 230, 187))
    paint.panel(x-1, y-4, 30, 12, 4, (38, 86, 60))
    fill_poly([(x+13,y-4), (x+22,y-15), (x+27,y-9), (x+20,y-3)], paint.mint)
    float eye = x+17
    if game.player.facing < 0:(eye = x+7)
    paint.rect(eye, y+10, 3, 4, paint.ink)
    paint.rect(x+1, y+18, 26, 5, (185, 78, 52))
    float scarf = x-9
    if game.player.facing < 0:(scarf = x+26)
    paint.rect(scarf, y+19+walk, 11, 5, (210, 106, 65))
)

def hud(Game game):(
    paint.panel(20, 20, 920, 58, 12, (24, 46, 42, 235))
    paint.label("ACORN RUN", 42, 34, 29, paint.cream, face)
    paint.acorn(283, 48, 0.70, paint.gold)
    paint.label(string(game.score) + " / 10", 308, 36, 25, paint.cream, face)
    paint.rect(412, 44, 1, 17, (75, 100, 80))
    for index in range(3):(
        color tint = (63, 83, 69)
        if index < game.hearts:(tint = (224, 123, 95))
        paint.heart(440+index*37, 37, tint)
    )
    paint.label("TRAIL " + string(game.checkpoint+1) + " / 3", 594, 39, 20, paint.muted, face)
    paint.label(string(int(game.elapsed)) + "s", 806, 37, 24, paint.cream, face)
    paint.rect(30, 604, 900, 2, (45, 67, 51))
    paint.rect(30, 604, 900 * game.player.x / (level.width-28), 2, paint.mint)
    paint.label("A / D  move", 30, 613, 18, paint.muted, face)
    paint.label("SPACE  jump", 223, 613, 18, paint.muted, face)
    paint.label("P  pause", 463, 613, 18, paint.muted, face)
    paint.label("R  restart", 646, 613, 18, paint.muted, face)
    paint.label("ESC  quit", 831, 613, 18, paint.muted, face)
    if game.notice > 0 and game.stage == PLAYING:(
        paint.panel(182, 94, 596, 40, 9, (24, 46, 42, 230))
        paint.centered(game.message, 480, 103, 20, paint.cream, face)
    )
)

def overlay(Game game):(
    if game.stage == PLAYING:(return)
    paint.rect(0, 0, 960, 640, (10, 29, 23, 135))
    paint.panel(174, 130, 620, 382, 18, (14, 34, 28, 75))
    paint.panel(168, 120, 620, 382, 18, (26, 51, 40))
    paint.rect(210, 149, 536, 2, (75, 105, 70))
    string heading = "ACORN RUN"
    string subtitle = "A tiny forest adventure, written entirely in Oak."
    string prompt = "PRESS ENTER TO BEGIN"
    if game.stage == PAUSED:(
        heading = "TAKE A BREATHER"
        subtitle = "The forest can wait. Your trail is saved."
        prompt = "PRESS P OR ENTER TO RESUME"
    )
    elif game.stage == WON:(
        heading = "THE GROVE IS HOME"
        subtitle = "All ten acorns, delivered in " + string(int(game.elapsed)) + " seconds."
        prompt = "PRESS ENTER TO PLAY AGAIN"
    )
    elif game.stage == LOST:(
        heading = "ONE MORE ADVENTURE?"
        subtitle = "You found " + string(game.score) + " of 10 acorns. The forest is rooting for you."
        prompt = "PRESS ENTER TO TRY AGAIN"
    )
    paint.acorn(478, 194, 1.5, paint.gold)
    paint.centered(heading, 478, 231, 40, paint.cream, face)
    paint.centered(subtitle, 478, 283, 22, paint.muted, face)
    if game.stage == TITLE:(
        paint.centered("Collect 10 acorns. Reach the glowing grove.", 478, 325, 23, paint.cream, face)
        paint.centered("Jump over thorns and beetles. Flags save your progress.", 478, 359, 20, paint.muted, face)
    )
    else:(
        paint.centered("R restarts the trail. Escape closes the window.", 478, 342, 21, paint.muted, face)
    )
    paint.panel(242, 411, 472, 52, 10, paint.mint)
    paint.centered(prompt, 478, 425, 23, paint.ink, face)
)

def render(Game game):(
    backdrop(game)
    world(game)
    player(game)
    hud(game)
    overlay(game)
)
