list acorns = [
    vec2(210, 491), vec2(360, 425), vec2(545, 338), vec2(710, 435),
    vec2(1085, 415), vec2(1360, 342), vec2(1530, 491),
    vec2(1915, 435), vec2(2200, 400), vec2(2440, 330)
]
list spikes = [vec2(650, 64), vec2(1310, 80), vec2(2130, 64)]
list patrols = [vec3(1080, 1200, 1.1), vec3(2270, 2350, 1.5)]
list checkpoints = [1000.0, 1900.0]

def beetle_x(int index, float seconds) -> float:(
    vec3 route = patrols[index]
    return route.x + (route.y - route.x) * (sin(seconds * route.z) * 0.5 + 0.5)
)
