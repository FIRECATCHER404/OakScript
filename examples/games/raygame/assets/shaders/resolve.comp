#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std430) readonly buffer Parameters { float p[]; };
layout(set=0,binding=1,std430) readonly buffer Lighting { vec4 lighting[]; };
layout(set=0,binding=2,std430) readonly buffer Guides { vec4 guides[]; };
layout(set=0,binding=3,rgba8) uniform writeonly image2D outputImage;
vec3 tonemap(vec3 x) { return clamp((x*(2.51*x+0.03))/(x*(2.43*x+0.59)+0.14),0.0,1.0); }
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy), size=imageSize(outputImage);
    if(any(greaterThanEqual(pixel,size))) return;
    int index=pixel.y*size.x+pixel.x;
    vec3 color=lighting[index].rgb;
    // Bloom uses filtered lighting so rejected fireflies cannot reappear as
    // bright dots or halos. Actual emissive surfaces remain unfiltered.
    vec3 bloom=vec3(0);
    for(int y=-2;y<=2;y++) for(int x=-2;x<=2;x++) {
        ivec2 at=clamp(pixel+ivec2(x,y)*3,ivec2(0),size-1);vec3 value=lighting[at.y*size.x+at.x].rgb;
        bloom+=max(value-vec3(3.0),vec3(0))*exp(-float(x*x+y*y)*0.55)*0.0035;
    }
    color=pow(tonemap((color+bloom)*1.45),vec3(1.0/2.2));
    imageStore(outputImage,pixel,vec4(color,1));
}
