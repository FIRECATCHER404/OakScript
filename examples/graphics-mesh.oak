window "OakScript - Vulkan Mesh and 3D Polygon" 800 600
mesh triangle = create_mesh([
    vertex((-1, -1, 0), (0, 0), (0, 0, -1), (235, 80, 80)),
    vertex((1, -1, 0), (1, 0), (0, 0, -1), (80, 235, 120)),
    vertex((0, 1, 0), (0.5, 1), (0, 0, -1), (80, 140, 235))
], [0, 1, 2])
triangle.position = (-1.4, 0, 0)
texture pattern = load_texture("assets/checker.png")
camera view = create_camera()

def draw():(
    clear((20, 28, 38))
    set_camera(view)
    draw_mesh(triangle)
    fill_poly([
        vertex((0.4, -1, 0), (0, 1)),
        vertex((2.4, -1, 0), (1, 1)),
        vertex((1.4, 1, 0), (0.5, 0))
    ], pattern)
    if key_down("Escape"):(close_window())
)
