\# Introspection, positional argument expansion, and Python-style slices. #\
def add(int a, int b, int c) -> int:(return a+b+c)
def maximum():(return max(*[1,2,3]))
def maximum_of(list values):(return max(*values))
int highest=maximum()
int other=maximum_of([4,5])
assert(highest==3 and other==5)

list values=[10,20,30,40,50]
print("reversed:",values[::-1])
print("stride:",values[1:5:2])
print("expanded call:",add(*values[:3]))
list combined=[0,*values,60]
print("combined:",combined)

tuple_value=(1,"Oak",true)
print("tuple slice:",tuple_value[::-1])
values[1:3]=[8,9,10]
print("slice assignment:",values)

bytearray bytes=bytearray([0,127,255])
print("bytes reversed:",bytes[::-1])
bytes[1:]=[1,2,3]
bytes[-1]=254
print("bytes:",bytes,"length:",bytes.length)

type Point:(int x;int y)
def double(int n) -> int:(return n*2)
type Object:(any callback=double;any constructor=Point;string label="Oak")
Object object=Object()
print("object attributes:",dir(object))
print("Point fields:",dir(Point))
print("bytearray attributes:",dir(bytes))
print("camera attributes:",dir(create_camera()))
assert(object.callback(4)==8)
assert(object.constructor(*[1,2]).y==2)
assert(bytearray("Oak")==bytearray([79,97,107]))
