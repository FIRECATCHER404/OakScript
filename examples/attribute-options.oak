\ Inspect options without changing the attribute or opening a window.
light lamp=create_light()
print(opt_dir(lamp,"type"))
print(opt_dir(lamp,"shadow_filter"))
assert(opt_dir(lamp,"type")==["directional","point","spot"])
assert(opt_dir(lamp,"shadow_filter")==["hard","pcf"])
assert(opt_dir(lamp,"intensity")==[])
assert(opt_dir(blend,"mode")==["additive","alpha","opaque"])
assert(opt_dir(depth,"mode")==["always","greater","less","less_equal","none"])
assert(opt_dir(cull,"mode")==["back","front","none"])

options Mode:(idle;active)
extend options Mode:(paused)
schema Stateful:(Mode mode=<idle>)
type Task from Stateful:(int count=0)
Task task=Task()
print(opt_dir(task,"mode"))
assert(opt_dir(task,"mode")==["active","idle","paused"])
assert(opt_dir(Task,"mode")==opt_dir(Stateful,"mode"))
assert(opt_dir(task,"count")==[])
list names=opt_dir(task,"mode")
names[0]="changed"
assert(opt_dir(task,"mode")[0]=="active")
task.mode=<paused>
assert(opt_dir(task,"mode")==["active","idle","paused"])

def inspect(value,name):(return opt_dir(value,name))
assert(inspect(vec3(0,0,0),"x")==[])
assert(inspect([],"length")==[])
assert(inspect("Oak","format")==[])
assert(inspect({},"keys")==[])
int rejected=0
try:(inspect(task,"typo"))
except TypeError:(rejected+=1)
try:(inspect(task,42))
except TypeError:(rejected+=1)
try:(inspect(3,"mode"))
except TypeError:(rejected+=1)
try:(inspect(task,"MODE"))
except TypeError:(rejected+=1)
assert(rejected==4)
