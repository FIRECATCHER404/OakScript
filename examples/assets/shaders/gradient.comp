#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0,rgba8) uniform image2D Target;
void main() { ivec2 p=ivec2(gl_GlobalInvocationID.xy); ivec2 size=imageSize(Target); if(any(greaterThanEqual(p,size))) return; imageStore(Target,p,vec4(vec2(p)/vec2(size-1),0.25,1)); }
