\# Collections, recoverable errors, lazy iteration, numbers and flexible calls. #\
dict scores = {"Ada": 10, "Oak": 20}
scores["Oak"] += 2
scores.update({"Lin": 15})
assert(scores.get("missing", 0) == 0)
dict copied = {**scores, "Ada": 30}
assert(copied["Ada"] == 30 and scores["Ada"] == 10)
set residues = {n%3 for n in range(20)}
assert(residues == {0,1,2} and 1 in residues)
assert(({1,2}|{2,3}) == {1,2,3})
frozenset key = frozenset([1,2])
dict keyed = {key: "immutable", (1,2): "tuple"}
assert(keyed[key] == "immutable")
bytes immutable = bytes([0, 127, 255])
assert(immutable[::-1] == bytes([255,127,0]))
first, *middle, last = (1,2,3,4)
assert(first == 1 and last == 4 and len(middle) == 2)
dict squares_by_number = {n:n*n for n in range(5)}
list pairs = [(x,y) for x in range(3) for y in range(3) if x<y]
assert(len(pairs) == 3 and squares_by_number[4] == 16)

def greeting(string name, string prefix="Hello", *, string ending="!") -> string:(
    return "{0}, {1}{2}".format(prefix,name,ending)
)
assert(greeting("Oak") == "Hello, Oak!")
assert(greeting(ending=".", name="Oak", prefix="Welcome") == "Welcome, Oak.")
dict options = {"name":"Oak", "ending":"?"}
assert(greeting(**options) == "Hello, Oak?")
def collect(first=1, *int values, **int labels):(
    return first+sum(values)+sum(labels.values())
)
assert(collect(2,3,4, extra=5) == 14)
function twice = lambda value: value*2
assert(twice(4) == 8)
def doubled(function original):(
    def wrapped(*values, **labels):(
        return original(*values, **labels)*2
    )
    return wrapped
)
@doubled
def add(a,b=1):(
    return a+b
)
assert(add(3,b=4) == 14)

bool recovered = false
try:(
    print(scores["missing"])
)
except KeyError as error:(
    recovered = error.name == "KeyError"
)
finally:(
    scores["cleanup"] = 1
)
assert(recovered and scores["cleanup"] == 1)
CustomError = exception_type("CustomError", ValueError)
try:(raise CustomError("demonstration"))
except ValueError as error:(assert(error.message == "demonstration"))

range huge = range(1000000000000)
assert(huge[-1] == 999999999999 and len(huge) == 1000000000000)
assert(list(range(6)[::-2]) == [5,3,1])
int produced = 0
bool cleaned = false
def squares(limit):(
    try:(
        for n in range(limit):(
            produced += 1
            yield n*n
        )
    )
    finally:(cleaned = true)
)
generator values = squares(1000000000000)
assert(produced == 0)
assert(next(values) == 0 and next(values) == 1 and produced == 2)
values.close()
assert(cleaned)
generator lazy = (n*n for n in range(4))
assert(sum(lazy) == 14)
assert(list(map(lambda n:n*2, range(3))) == [0,2,4])
assert(list(filter(lambda n:n%2==0, range(6))) == [0,2,4])
for index, value in enumerate([10,20],5):(
    assert(value == (index-4)*10)
)
assert(list(zip([1,2],[3,4])) == [(1,3),(2,4)])

assert((0xff & 0b1010) == 10 and (3^5) == 6 and (2|4) == 6)
assert(~0 == -1 and 1<<8 == 256 and -8>>2 == -2)
assert(-7//3 == -3 and 1_000 == 1000 and 0o17 == 15)
assert(1 < 2 < 3 and not (3 < 2 < 1))
bigint enormous = bigint(2)**200
assert(enormous>>200 == 1 and enormous+1 > enormous)
decimal exact = decimal("0.1")+decimal("0.2")
assert(exact == decimal("0.3"))
complex rotation = (1+2j)*(1-2j)
assert(rotation.real == 5 and rotation.imag == 0)
println("All five language-feature examples passed.")
